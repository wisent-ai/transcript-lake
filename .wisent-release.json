{
  "schema_version": 1,
  "product": "transcript-lake",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "source-recovery-and-projections",
          "argv": [
            "cargo",
            "test",
            "--locked",
            "--test",
            "source_rewrite",
            "--test",
            "oko_export_role",
            "--test",
            "show_out",
            "--target-dir",
            ".wisent-output/target"
          ]
        }
      ],
      "build": {
        "argv": [
          "cargo",
          "build",
          "--manifest-path",
          "Cargo.toml",
          "--locked",
          "--release",
          "--bin",
          "transcript-lake",
          "--target",
          "aarch64-apple-darwin",
          "--target-dir",
          ".wisent-output/target"
        ]
      },
      "stage": {
        "target/aarch64-apple-darwin/release/transcript-lake": "bin/transcript-lake"
      }
    }
  },
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": false
  }
}
